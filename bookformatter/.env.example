# Copy this file to ".env" and fill in your key. NEVER commit the real .env.
# The packaged app does not need this file - it asks for the key in the window
# and stores it in ~/.book_formatter.json instead.
OPENAI_API_KEY=sk-your-key-here

# Optional: override the default model (gpt-4o-mini)
# OPENAI_MODEL=gpt-4o
